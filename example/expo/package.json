    "react-native-web": "~0.21.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "57.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
