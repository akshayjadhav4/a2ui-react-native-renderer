{
  "name": "a2ui-react-native-renderer",
  "version": "0.0.0-development",
  "description": "A catalog-agnostic A2UI renderer and protocol runtime for React Native and Expo",
  "keywords": [
    "a2ui",
    "react-native",
    "expo",
    "generative-ui",
    "agent-ui",
    "ai",
    "renderer"
  ],
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "react-native": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./lib/module/index.js",
      "import": "./lib/module/index.js",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bob build",
    "prepare": "pnpm build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.type-tests.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier --write src test package.json tsconfig.json tsconfig.type-tests.json eslint.config.mjs README.md",
    "format:check": "prettier --check src test package.json tsconfig.json tsconfig.type-tests.json eslint.config.mjs README.md",
    "example:typecheck": "pnpm --filter a2ui-renderer-example typecheck",
    "example:check": "pnpm example:typecheck && pnpm --filter a2ui-renderer-example lint",
    "example:export": "pnpm build && pnpm --filter a2ui-renderer-example export",
    "test": "pnpm build && node --test test/unit/*.test.mjs test/integration/*.test.mjs",
    "test:coverage": "pnpm build && node --test --experimental-test-coverage test/unit/*.test.mjs test/integration/*.test.mjs",
    "pack:check": "npm pack --dry-run --cache .npm-cache",
    "release:check": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm pack:check"
  },
  "peerDependencies": {
    "react": ">=18.2",
    "react-native": ">=0.76",
    "zod": ">=3.25 <4"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.15.1",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-builder-bob": "0.43.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.64.0",
    "zod": "3.25.76"
  },
  "dependencies": {
    "@a2ui/web_core": "0.9.0"
  }
}
